# ==========================================
# ENV TEMPLATE UNTUK BACKEND FASTIFY
# Copy file ini menjadi .env lalu sesuaikan
#
# PENTING: file ini ter-commit ke repositori.
# JANGAN pernah menaruh nilai asli di sini — gunakan placeholder.
# ==========================================

# Server Configuration
PORT=3000
# Alamat bind. Biarkan 127.0.0.1 di VPS — nginx yang memegang 80/443 dan
# mem-proxy ke sini. Isi 0.0.0.0 hanya bila prosesnya jalan di dalam container.
HOST=127.0.0.1
NODE_ENV=development # Ubah ke 'production' di VPS
FRONTEND_URL=http://localhost:5173,http://localhost:3000 # Ganti dengan domain frontend di VPS (misal https://podorukuntrack.com)

# Database PostgreSQL
# Dipakai runtime aplikasi. Bila penyedia database menawarkan beberapa mode
# koneksi, pilih transaction pooler: koneksi server dipakai bergantian antar
# transaksi, sehingga kuota koneksi tidak habis oleh proses PM2 cluster.
#
# Tambahkan ?sslmode=require hanya bila penyedia benar-benar melayani TLS.
# Bila tidak, sambungan gagal dengan pesan menyesatkan "SSL routines:
# wrong version number" — yang sebenarnya berarti server menjawab handshake
# TLS dengan protokol polos. Uji dulu dengan psql sebelum mengisinya.
DATABASE_URL=postgres://user:password@host:6543/dbname

# Dipakai drizzle-kit saja (generate/migrate/push) dan perintah pg_dump /
# pg_restore / psql. Wajib session pooler atau direct connection — DDL dan
# prepared statement gagal lewat transaction pooler. Boleh dikosongkan bila
# database tidak berada di belakang pooler; drizzle.config.js akan memakai
# DATABASE_URL.
MIGRATION_DATABASE_URL=postgres://user:password@host:5432/dbname

# Batas koneksi pool per proses Node. Total ke database = nilai ini dikali
# jumlah instance PM2 (satu per vCPU). Jaga hasil kalinya tetap di bawah kuota
# koneksi paket database. Kosong = 10.
DB_POOL_MAX=10

# Redis Configuration
# Redis wajib berpassword. Sertakan password di REDIS_URL dengan format
# redis://:<password>@127.0.0.1:6379 (perhatikan titik dua sebelum password —
# Redis tidak memakai username).
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
# Dipakai kedua file docker-compose. Wajib diisi — tidak ada nilai cadangan.
# Bangkitkan dengan: openssl rand -base64 32
REDIS_PASSWORD=

# JWT Authentication — wajib diisi, aplikasi menolak start bila kosong
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Cloudflare R2 Storage (Untuk Upload Dokumen)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# WhatsApp Microservice (WAHA) — dibaca backend saat mengirim pesan.
# Nilainya harus sama dengan WAHA_API_KEY di bagian bawah.
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_API_URL=http://localhost:2785

# Backend API URL (Untuk Swagger Docs & Config lainnya)
API_URL=http://localhost:3000

# Email SMTP Configuration (Untuk OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@podorukuntrack.com

# Sign in with Apple (opsional — untuk revoke token saat hapus akun)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# WAHA (WhatsApp HTTP API) Configuration — dipakai docker-compose.prod.yml.
# Wajib diisi; container menolak start bila kosong.
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
