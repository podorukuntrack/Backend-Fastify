# Dedicated staging environment only. Generate secrets on server; never copy production .env.
NODE_ENV=staging
STAGING_DATABASE_URL=postgres://ROLE:STAGING_SECRET@127.0.0.1:55440/prtrack_staging
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=55440
STAGING_DB_NAME=prtrack_staging
STAGING_DB_ROLE=prtrack_sync_reader
STAGING_INSTANCE_ID=REPLACE_WITH_VERIFIED_DATABASE_MARKER
STAGING_PORT=3201
TRACK_SYNC_TOKEN=GENERATE_WITH_CRYPTO_RANDOMBYTES_32_HEX
