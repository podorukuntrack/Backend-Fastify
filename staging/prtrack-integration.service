[Unit]
Description=PodoRukunTrack integration API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=podorukuntrack
WorkingDirectory=/home/podorukuntrack/Backend-Fastify
EnvironmentFile=/etc/prtrack-integration/runtime.env
ExecStart=/home/podorukuntrack/.nvm/versions/node/v22.23.2/bin/node src/sync-server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
UMask=0077

[Install]
WantedBy=multi-user.target
