# Separate integration listener; never load production notifier/worker entrypoints.
NODE_ENV=production
TRACK_SYNC_HOST=127.0.0.1
TRACK_SYNC_PORT=3202
TRACK_SYNC_ALLOWED_IPS=127.0.0.1
TRACK_SYNC_SOURCE_ID=
# No new DB roles: use the existing Track application account on the Track host.
TRACK_SYNC_DB_MODE=application
TRACK_SYNC_DB_USER=
TRACK_SYNC_DATABASE_URL=
# Leave blank in application mode. Restricted mode requires its own writer URL.
TRACK_SYNC_WRITER_DATABASE_URL=
TRACK_SYNC_TOKEN=
TRACK_SCHEDULE_TOKEN=
TRACK_MONITOR_TOKEN=
SYNC_WRITE_ENABLED=false
# Business API gets this flag separately, only after DB mode and UAT are ready.
SI_BILLING_ENABLED=false
